{
  "profile": "cloud",
  "cache_path": ".sn_cache/pasa_hybrid_full_dev.sqlite",
  "reranker": {
    "backend": "api",
    "base_url": "https://api.siliconflow.cn/v1",
    "model": "BAAI/bge-reranker-v2-m3",
    "api_key_env": "SILICONFLOW_API_KEY",
    "batch": 64,
    "timeout": 60
  },
  "sources": {
    "openalex": {"enabled": false},
    "s2": {"enabled": false},
    "arxiv": {"enabled": false},
    "pubmed": {"enabled": false, "email": ""},
    "pasa": {
      "enabled": true,
      "index_path": "data/pasa/papers.sqlite",
      "paper_zip": "E:/新的codex工作区/_review_20260819/official_reference_data/PaSa/paper_database/cs_paper_2nd.zip",
      "id_map": "E:/新的codex工作区/_review_20260819/official_reference_data/PaSa/paper_database/id2paper.json",
      "reference_hydrate_limit": 0,
      "max_search_limit": 2000
    },
    "pasa_dense": {
      "enabled": true,
      "index_dir": "data/pasa/siliconflow_bge_m3_full",
      "paper_db": "data/pasa/papers.sqlite",
      "model": "BAAI/bge-m3",
      "api_key_env": "SILICONFLOW_API_KEY",
      "block_size": 8192,
      "timeout": 60
    }
  },
  "pipeline": {
    "max_rounds": 1,
    "per_query_limit": 1000,
    "l1_keep": 1500,
    "l2_keep": 100,
    "citation_expand_seeds": 0,
    "l3_policy": "disabled",
    "max_l3_judgments": 0,
    "enable_query_evolution": false,
    "use_propensity": false,
    "calibrator": "rank_decay",
    "n_hat_prior_override": 5,
    "n_hat_prior_sd": 2
  }
}
