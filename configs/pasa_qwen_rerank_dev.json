{
  "profile": "cloud",
  "llm_judge": {
    "backend": "openai_compat",
    "model": "qwen-flash",
    "base_url": "https://dashscope.aliyuncs.com/compatible-mode/v1",
    "api_key_env": "DASHSCOPE_API_KEY",
    "temperature": 0.0,
    "max_tokens": 900,
    "timeout": 20
  },
  "cache_path": ".sn_cache/pasa_refs_v2.sqlite",
  "reranker": {
    "backend": "qwen",
    "model": "qwen3-rerank",
    "base_url": "https://dashscope.aliyuncs.com/compatible-mode/v1",
    "api_key_env": "DASHSCOPE_API_KEY",
    "batch": 64,
    "timeout": 60
  },
  "sources": {
    "openalex": {"enabled": true, "mailto_env": "OPENALEX_MAILTO"},
    "s2": {"enabled": false, "api_key_env": "S2_API_KEY"},
    "arxiv": {"enabled": false},
    "pubmed": {"enabled": false, "email": ""},
    "pasa": {
      "enabled": true,
      "index_path": "data/pasa/papers.sqlite",
      "paper_zip": "E:/新的codex工作区/_review_20260819/official_reference_data/PaSa/paper_database/cs_paper_2nd.zip",
      "id_map": "E:/新的codex工作区/_review_20260819/official_reference_data/PaSa/paper_database/id2paper.json"
    }
  },
  "pipeline": {
    "max_rounds": 1,
    "per_query_limit": 30,
    "l1_keep": 120,
    "l2_keep": 80,
    "citation_graph_min_constraint": 0.20,
    "l3_policy": "reference_first",
    "max_l3_judgments": 6,
    "l3_max_papers": 6,
    "l3_batch_size": 6,
    "enable_query_evolution": false,
    "use_propensity": false,
    "calibrator": "rank_decay",
    "n_hat_prior_override": 3,
    "n_hat_prior_sd": 2
  }
}
